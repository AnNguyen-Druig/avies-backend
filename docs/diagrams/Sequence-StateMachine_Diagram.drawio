  <diagram id="OekzozkK7qjaoRiNQ4b3" name="Sequence-Diagram_Workflow3">
    <mxGraphModel dx="6578" dy="3364" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\n%%{init: {\&quot;sequence\&quot;: {\&quot;mirrorActors\&quot;: false}}}%%\nsequenceDiagram\n    autonumber\n    actor SV as Student\n    participant FE as examRoom:ExamRoomUI\n    participant API as examApi:ExamRestController\n    participant WS as wsGateway:ExamWebSocketGateway\n    participant STT as stt:StreamingSTTService\n    participant ORCH as orchestrator:ExamOrchestrator\n    participant DB as aivesDB:PostgreSQL\n    participant AI as examiner:AIExaminer\n    participant TTS as tts:TextToSpeechService\n    participant F4 as grading:GradingService\n\n    Note over SV,DB: Precondition: ExamSession and StudentExam were assigned in Feature 2.\n    Note over ORCH,DB: Server enforces deadline, question limits and approved-question scope.\n\n    SV-&gt;&gt;FE: Open assigned exam and select Start\n    FE-&gt;&gt;FE: Check microphone permission and readiness\n    alt Microphone unavailable\n        FE-)SV: Show microphone error; exam not started\n    else Microphone ready\n        FE-&gt;&gt;+API: POST /student-exams/{id}/start (JWT)\n        API-&gt;&gt;+ORCH: startExam(examId, authenticatedUserId)\n        ORCH-&gt;&gt;+DB: Load assigned exam and session settings\n        DB--&gt;&gt;-ORCH: Ownership, schedule, status, limits\n        alt Exam not eligible\n            ORCH--&gt;&gt;-API: Business error\n            API--&gt;&gt;-FE: HTTP 403 / 409 / 422\n        else Exam eligible\n            ORCH-&gt;&gt;+DB: Atomically set status to IN_PROGRESS\n            DB--&gt;&gt;-ORCH: Started exam and server deadline\n            ORCH--&gt;&gt;-API: Exam context and short-lived WS ticket\n            API--&gt;&gt;-FE: 200 OK with exam context and ticket\n\n            FE-&gt;&gt;+WS: Connect WSS using ticket\n            WS-&gt;&gt;+ORCH: Validate ticket and active exam\n            ORCH--&gt;&gt;-WS: Authorized and current exam state\n            WS--&gt;&gt;-FE: EXAM_READY with remaining time\n\n            loop While main-question quota and time remain\n                FE-)WS: REQUEST_NEXT_MAIN (automatic)\n                WS-&gt;&gt;+ORCH: nextMainQuestion(examId)\n                ORCH-&gt;&gt;+DB: Select non-repeated APPROVED question; save turn\n                DB--&gt;&gt;-ORCH: Question, assignment ID and turn\n                ORCH-&gt;&gt;+TTS: Synthesize main question\n                TTS--&gt;&gt;-ORCH: Generated audio\n                ORCH--&gt;&gt;-WS: MAIN_QUESTION (text, audio, id)\n                WS-)FE: Deliver MAIN_QUESTION\n                FE-&gt;&gt;FE: Play question, then auto-start microphone\n\n                loop While current question is open and time remains\n                    SV-)FE: Speak an answer\n                    FE-)WS: Stream AUDIO_CHUNK until VAD_END\n                    WS-)STT: Stream audio and finalize on VAD_END\n                    STT-)WS: FINAL_TRANSCRIPT or recognition error\n                    alt Usable final transcript\n                        WS-&gt;&gt;+ORCH: onAnswerFinal(questionId, turnId, text)\n                        ORCH-&gt;&gt;+DB: Save answer with turnId deduplication\n                        DB--&gt;&gt;-ORCH: Confirm persisted answer\n                        ORCH-&gt;&gt;+AI: Evaluate whether to ask a follow-up\n                        AI--&gt;&gt;-ORCH: Proposed follow-up or no follow-up\n                        alt Follow-up valid and within limits\n                            ORCH-&gt;&gt;DB: Persist follow-up question turn\n                            ORCH-&gt;&gt;+TTS: Synthesize follow-up question\n                            TTS--&gt;&gt;-ORCH: Generated audio\n                            ORCH--&gt;&gt;-WS: FOLLOW_UP_QUESTION (text, audio)\n                            WS-)FE: Deliver FOLLOW_UP_QUESTION\n                            FE-&gt;&gt;FE: Play audio, then auto-listen again\n                        else No follow-up or limit reached\n                            ORCH--&gt;&gt;-WS: MAIN_QUESTION_DONE\n                            WS-)FE: Close current question; continue automatically\n                        end\n                    else Silence or STT recognition failure\n                        WS-)FE: RETRY_ANSWER\n                    end\n                end\n            end\n\n            opt Server deadline reached during an answer\n                ORCH-)WS: STOP_CAPTURE\n                WS-)FE: Stop microphone capture\n            end\n\n            WS-&gt;&gt;+ORCH: finishExamIfDue(examId)\n            ORCH-&gt;&gt;+DB: Atomically finalize exam as COMPLETED\n            DB--&gt;&gt;-ORCH: Completion receipt\n            ORCH-)F4: EXAM_COMPLETED (transcript references)\n            ORCH--&gt;&gt;-WS: Exam completion receipt\n            WS-)FE: EXAM_COMPLETED and submission receipt\n            Note over F4: Feature 4 proposes rubric scores; lecturer approves final grade.\n        end\n    end\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ShkNDjff5PhlYMgw3q0P-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Student" mermaidId="n:SV" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;sequenceEdgeStyle&quot;,&quot;libavoidRouting&quot;:0,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=12;lifelineColor=#28253D;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fontFamily=Recursive;fontSize=16;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="Student" id="ShkNDjff5PhlYMgw3q0P-2">
