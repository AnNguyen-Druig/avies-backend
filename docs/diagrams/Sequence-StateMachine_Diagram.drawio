  <diagram id="znRqoe7KT-l5CegC5YX6" name="Sequence-Diagram_Workflow4">
    <mxGraphModel dx="1432" dy="841" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor L as Lecturer\n    participant FE as Frontend\n    participant BE as Backend\n    participant DB as Database\n    participant AI as AI service\n\n    Note over BE,AI: Phase 1 - Automatic AI grading\n    BE-&gt;&gt;DB: Fetch transcripts, rubric, reference answer\n    DB--&gt;&gt;BE: Grading data\n    BE-&gt;&gt;AI: Grading request\n    AI--&gt;&gt;BE: Per-criterion scores + feedback\n    BE-&gt;&gt;DB: Save question_grades, question_grade_criteria\n    BE-&gt;&gt;DB: Update student_exams.ai_suggested_score\n\n    Note over L,DB: Phase 2 - Lecturer review\n    L-&gt;&gt;FE: Open exam for grading\n    FE-&gt;&gt;BE: Fetch exam for grading\n    BE-&gt;&gt;DB: Verify lecturer permission\n    DB--&gt;&gt;BE: Exam, AI scores, transcripts\n    BE--&gt;&gt;FE: Return data\n    L-&gt;&gt;FE: Adjust scores and confirm\n    FE-&gt;&gt;BE: Submit final scores\n    BE-&gt;&gt;DB: Save final_score in question_grades\n    BE-&gt;&gt;DB: Write grade_audit_logs\n    Note over BE,DB: Only after the lecturer has finalized all questions\n    BE-&gt;&gt;DB: Update student_exams.final_score\n    BE--&gt;&gt;FE: Success&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="vFOZommY08h5zeN5ohb8-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Lecturer" mermaidId="n:L" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;sequenceEdgeStyle&quot;,&quot;libavoidRouting&quot;:0,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=12;lifelineColor=#28253D;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fontFamily=Recursive;fontSize=16;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="Lecturer" id="vFOZommY08h5zeN5ohb8-2">
