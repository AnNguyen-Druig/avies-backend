  <diagram name="Class-Diagram" id="LeyaF5HfvpyAg0YpelC6">
    <mxGraphModel dx="5280" dy="2103" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass Role {\n    -id: Long\n    -code: String\n    -name: String\n    -description: String\n\n    +updateDetails(in name: String, in description: String) void\n}\n\nclass User {\n    -id: Long\n    -roleId: Long\n    -username: String\n    -email: String\n    -passwordHash: String\n    -googleSub: String\n    -fullName: String\n    -createdAt: DateTime\n\n    +updateProfile(in fullName: String) void\n    +hasRole(in roleCode: String) boolean\n}\n\nclass Subject {\n    -id: Long\n    -code: String\n    -name: String\n    -description: String\n\n    +updateDetails(in name: String, in description: String) void\n}\n\nclass LearningMaterial {\n    -id: Long\n    -subjectId: Long\n    -uploadedBy: Long\n    -title: String\n    -fileName: String\n    -storagePath: String\n    -mimeType: String\n    -processingStatus: String\n    -createdAt: DateTime\n\n    +markProcessing() void\n    +markReady() void\n    +markFailed() void\n}\n\nclass Question {\n    -id: Long\n    -subjectId: Long\n    -createdBy: Long\n    -content: String\n    -bloomLevel: String\n    -aiGenerated: Boolean\n    -approved: Boolean\n    -createdAt: DateTime\n\n    +updateContent(in content: String) void\n    +setBloomLevel(in bloomLevel: String) void\n    +approve() void\n}\n\nclass Rubric {\n    -id: Long\n    -questionId: Long\n    -title: String\n    -description: String\n    -createdAt: DateTime\n\n    +updateDetails(in title: String, in description: String) void\n    +addCriterion(in criterion: RubricCriterion) void\n}\n\nclass RubricCriterion {\n    -id: Long\n    -rubricId: Long\n    -criterionText: String\n    -pointWeight: Decimal\n    -mandatory: Boolean\n    -displayOrder: Integer\n\n    +updateCriterion(in criterionText: String) void\n    +updateWeight(in pointWeight: Decimal) void\n    +setMandatory(in mandatory: Boolean) void\n}\n\nclass ExamSession {\n    -id: Long\n    -lecturerId: Long\n    -subjectId: Long\n    -title: String\n    -status: String\n    -maxMainQuestions: Integer\n    -maxFollowUps: Integer\n    -createdAt: DateTime\n\n    +configureLimits(in maxMainQuestions: Integer, in maxFollowUps: Integer) void\n    +start() void\n    +complete() void\n    +canAskMainQuestion() boolean\n    +canAskFollowUp() boolean\n}\n\nclass StudentExam {\n    -id: Long\n    -sessionId: Long\n    -studentId: Long\n    -status: String\n    -aiSuggestedScore: Decimal\n    -finalScore: Decimal\n    -aiFeedback: String\n    -audioRecordUrl: String\n    -startedAt: DateTime\n    -completedAt: DateTime\n\n    +start() void\n    +complete() void\n    +applyAIGrading(in score: Decimal, in feedback: String) void\n    +finalizeGrade(in finalScore: Decimal) void\n}\n\nclass StudentExamQuestion {\n    -id: Long\n    -studentExamId: Long\n    -questionId: Long\n    -questionOrder: Integer\n\n    +addTranscriptTurn(in turn: TranscriptTurn) void\n}\n\nclass TranscriptTurn {\n    -id: Long\n    -studentExamQuestionId: Long\n    -turnNo: Integer\n    -turnType: String\n    -content: String\n    -aiEvalScore: Decimal\n    -createdAt: DateTime\n\n    +setAiEvaluation(in score: Decimal) void\n    +isStudentAnswer() boolean\n}\n\n\nRole \&quot;1\&quot; -- \&quot;0..*\&quot; User : assigned to\n\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; LearningMaterial : uploads\nSubject \&quot;1\&quot; -- \&quot;0..*\&quot; LearningMaterial : contains\n\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Question : creates\nSubject \&quot;1\&quot; -- \&quot;0..*\&quot; Question : contains\n\nQuestion \&quot;1\&quot; *-- \&quot;0..1\&quot; Rubric : has\nRubric \&quot;1\&quot; *-- \&quot;1..*\&quot; RubricCriterion : contains\n\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; ExamSession : conducts\nSubject \&quot;1\&quot; -- \&quot;0..*\&quot; ExamSession : organizes\n\nExamSession \&quot;1\&quot; *-- \&quot;0..*\&quot; StudentExam : includes\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; StudentExam : takes\n\nStudentExam \&quot;1\&quot; *-- \&quot;0..*\&quot; StudentExamQuestion : contains\nQuestion \&quot;1\&quot; -- \&quot;0..*\&quot; StudentExamQuestion : selected as\n\nStudentExamQuestion \&quot;1\&quot; *-- \&quot;0..*\&quot; TranscriptTurn : records&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="p-aMn48ID3NKDeyX3GSx-1">
