  <diagram name="Physical-ERD" id="OITwkFLVLqXylv3CVpDD">
    <mxGraphModel dx="6578" dy="3364" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    direction LR\n\n    %% =========================================================\n    %% AIVES PHYSICAL ERD\n    %% PostgreSQL / Supabase\n    %% Schema: aives\n    %% Baseline: AIVES_DB_POSTGRESQL_FINAL(2).sql - 2026-09-28\n    %% =========================================================\n\n\n    %% =========================================================\n    %% 1. MASTER DATA &amp; AUTHENTICATION\n    %% =========================================================\n\n    roles {\n        BIGINT id PK \&quot;IDENTITY; NOT NULL\&quot;\n        VARCHAR(20) code UK \&quot;NOT NULL; CHECK ADMIN, LECTURER, STUDENT\&quot;\n        VARCHAR(100) name \&quot;NOT NULL\&quot;\n        TEXT description \&quot;NULL\&quot;\n    }\n\n    users {\n        BIGINT id PK \&quot;IDENTITY; NOT NULL\&quot;\n        BIGINT role_id FK \&quot;NOT NULL\&quot;\n        VARCHAR(50) username UK \&quot;NOT NULL\&quot;\n        VARCHAR(255) email UK \&quot;NOT NULL\&quot;\n        VARCHAR(255) password_hash \&quot;NULL\&quot;\n        VARCHAR(255) google_sub UK \&quot;NULL; Google OIDC subject\&quot;\n        VARCHAR(100) full_name \&quot;NOT NULL\&quot;\n        TIMESTAMPTZ created_at \&quot;NOT NULL; DEFAULT CURRENT_TIMESTAMP\&quot;\n    }\n\n    refresh_tokens {\n        BIGINT id PK \&quot;IDENTITY; NOT NULL\&quot;\n        BIGINT user_id FK \&quot;NOT NULL\&quot;\n        VARCHAR(255) token_hash UK \&quot;NOT NULL; hashed token only\&quot;\n        TIMESTAMPTZ expires_at \&quot;NOT NULL; CHECK expires_at &gt; created_at\&quot;\n        TIMESTAMPTZ revoked_at \&quot;NULL; CHECK revoked_at &gt;= created_at\&quot;\n        TIMESTAMPTZ created_at \&quot;NOT NULL; DEFAULT CURRENT_TIMESTAMP\&quot;\n    }\n\n    subjects {\n        BIGINT id PK \&quot;IDENTITY; NOT NULL\&quot;\n        VARCHAR(20) code UK \&quot;NOT NULL\&quot;\n        VARCHAR(255) name \&quot;NOT NULL\&quot;\n        TEXT description \&quot;NULL\&quot;\n    }\n\n\n    %% =========================================================\n    %% 2. LEARNING MATERIAL &amp; RAG\n    %% =========================================================\n\n    learning_materials {\n        BIGINT id PK \&quot;IDENTITY; NOT NULL\&quot;\n        BIGINT subject_id FK \&quot;NOT NULL\&quot;\n        BIGINT uploaded_by FK \&quot;NOT NULL\&quot;\n        VARCHAR(255) title \&quot;NOT NULL\&quot;\n        VARCHAR(255) file_name \&quot;NOT NULL\&quot;\n        VARCHAR(500) storage_path \&quot;NOT NULL\&quot;\n        VARCHAR(100) mime_type \&quot;NULL\&quot;\n        VARCHAR(20) processing_status \&quot;NOT NULL; DEFAULT PENDING; CHECK PENDING, PROCESSING, READY, FAILED\&quot;\n        TIMESTAMPTZ created_at \&quot;NOT NULL; DEFAULT CURRENT_TIMESTAMP\&quot;\n    }\n\n    learning_material_chunks {\n        BIGINT id PK \&quot;IDENTITY; NOT NULL\&quot;\n        BIGINT learning_material_id FK \&quot;NOT NULL; COMPOSITE UQ with chunk_index\&quot;\n        INT chunk_index \&quot;NOT NULL; CHECK &gt;= 0; COMPOSITE UQ with learning_material_id\&quot;\n        TEXT content \&quot;NOT NULL\&quot;\n        VECTOR(1536) embedding \&quot;NULL\&quot;\n        TIMESTAMPTZ created_at \&quot;NOT NULL; DEFAULT CURRENT_TIMESTAMP\&quot;\n    }\n\n\n    %% =========================================================\n    %% 3. QUESTION BANK &amp; RUBRIC\n    %% =========================================================\n\n    questions {\n        BIGINT id PK \&quot;IDENTITY; NOT NULL\&quot;\n        BIGINT subject_id FK \&quot;NOT NULL\&quot;\n        BIGINT created_by FK \&quot;NOT NULL\&quot;\n        TEXT content \&quot;NOT NULL\&quot;\n        VARCHAR(20) bloom_level \&quot;NULL; CHECK Bloom taxonomy values\&quot;\n        BOOLEAN is_ai_generated \&quot;NOT NULL; DEFAULT TRUE\&quot;\n        BOOLEAN is_approved \&quot;NOT NULL; DEFAULT FALSE\&quot;\n        TIMESTAMPTZ created_at \&quot;NOT NULL; DEFAULT CURRENT_TIMESTAMP\&quot;\n    }\n\n    rubrics {\n        BIGINT id PK \&quot;IDENTITY; NOT NULL\&quot;\n        BIGINT question_id FK,UK \&quot;NOT NULL; one rubric maximum per question\&quot;\n        VARCHAR(255) title \&quot;NULL\&quot;\n        TEXT description \&quot;NULL\&quot;\n        TIMESTAMPTZ created_at \&quot;NOT NULL; DEFAULT CURRENT_TIMESTAMP\&quot;\n    }\n\n    rubric_criteria {\n        BIGINT id PK \&quot;IDENTITY; NOT NULL\&quot;\n        BIGINT rubric_id FK \&quot;NOT NULL; COMPOSITE UQ with display_order\&quot;\n        TEXT criterion_text \&quot;NOT NULL\&quot;\n        NUMERIC point_weight \&quot;DB TYPE NUMERIC(5,2); NOT NULL; CHECK &gt;= 0\&quot;\n        BOOLEAN is_mandatory \&quot;NOT NULL; DEFAULT FALSE\&quot;\n        INT display_order \&quot;NOT NULL; DEFAULT 1; CHECK &gt; 0; COMPOSITE UQ with rubric_id\&quot;\n    }\n\n\n    %% =========================================================\n    %% 4. AI-POWERED VIVA EXAM\n    %% =========================================================\n\n    exam_sessions {\n        BIGINT id PK \&quot;IDENTITY; NOT NULL\&quot;\n        BIGINT lecturer_id FK \&quot;NOT NULL\&quot;\n        BIGINT subject_id FK \&quot;NOT NULL\&quot;\n        VARCHAR(255) title \&quot;NOT NULL\&quot;\n        VARCHAR(20) status \&quot;NOT NULL; DEFAULT UPCOMING; CHECK UPCOMING, ONGOING, COMPLETED\&quot;\n        INT max_main_questions \&quot;NOT NULL; DEFAULT 3; CHECK &gt; 0\&quot;\n        INT max_follow_ups \&quot;NOT NULL; DEFAULT 2; CHECK &gt;= 0\&quot;\n        TIMESTAMPTZ created_at \&quot;NOT NULL; DEFAULT CURRENT_TIMESTAMP\&quot;\n    }\n\n    student_exams {\n        BIGINT id PK \&quot;IDENTITY; NOT NULL\&quot;\n        BIGINT session_id FK \&quot;NOT NULL; COMPOSITE UQ with student_id\&quot;\n        BIGINT student_id FK \&quot;NOT NULL; COMPOSITE UQ with session_id\&quot;\n        VARCHAR(20) status \&quot;NOT NULL; DEFAULT ASSIGNED; CHECK ASSIGNED, IN_PROGRESS, COMPLETED\&quot;\n        NUMERIC ai_suggested_score \&quot;DB TYPE NUMERIC(5,2); NULL; CHECK 0 to 10\&quot;\n        NUMERIC final_score \&quot;DB TYPE NUMERIC(5,2); NULL; CHECK 0 to 10\&quot;\n        TEXT ai_feedback \&quot;NULL\&quot;\n        VARCHAR(500) audio_record_url \&quot;NULL\&quot;\n        TIMESTAMPTZ started_at \&quot;NULL\&quot;\n        TIMESTAMPTZ completed_at \&quot;NULL; CHECK &gt;= started_at\&quot;\n    }\n\n    student_exam_questions {\n        BIGINT id PK \&quot;IDENTITY; NOT NULL\&quot;\n        BIGINT student_exam_id FK \&quot;NOT NULL; part of two COMPOSITE UQs\&quot;\n        BIGINT question_id FK \&quot;NOT NULL; UQ with student_exam_id\&quot;\n        INT question_order \&quot;NOT NULL; CHECK &gt; 0; UQ with student_exam_id\&quot;\n    }\n\n\n    %% =========================================================\n    %% 5. VIVA CONVERSATION / TRANSCRIPT\n    %% =========================================================\n\n    transcripts {\n        BIGINT id PK \&quot;IDENTITY; NOT NULL\&quot;\n        BIGINT student_exam_question_id FK \&quot;NOT NULL; COMPOSITE UQ with turn_no\&quot;\n        INT turn_no \&quot;NOT NULL; CHECK &gt; 0; COMPOSITE UQ with student_exam_question_id\&quot;\n        VARCHAR(20) turn_type \&quot;NOT NULL; CHECK AI_MAIN_Q, STUDENT_ANS, AI_FOLLOW_UP\&quot;\n        TEXT content \&quot;NOT NULL\&quot;\n        NUMERIC ai_eval_score \&quot;DB TYPE NUMERIC(5,2); NULL; CHECK 0 to 10\&quot;\n        TIMESTAMPTZ created_at \&quot;NOT NULL; DEFAULT CURRENT_TIMESTAMP\&quot;\n    }\n\n\n    %% =========================================================\n    %% CROW&#39;S FOOT RELATIONSHIPS\n    %%\n    %% || = exactly one\n    %% o| = zero or one\n    %% o{ = zero or many\n    %% .. = non-identifying relationship\n    %% =========================================================\n\n    roles ||..o{ users : assigns\n\n    users ||..o{ refresh_tokens : owns\n\n    subjects ||..o{ learning_materials : contains\n    users ||..o{ learning_materials : uploads\n\n    learning_materials ||..o{ learning_material_chunks : contains\n\n    subjects ||..o{ questions : contains\n    users ||..o{ questions : creates\n\n    questions ||..o| rubrics : has\n    rubrics ||..o{ rubric_criteria : contains\n\n    users ||..o{ exam_sessions : conducts\n    subjects ||..o{ exam_sessions : belongs_to\n\n    exam_sessions ||..o{ student_exams : contains\n    users ||..o{ student_exams : takes\n\n    student_exams ||..o{ student_exam_questions : contains\n    questions ||..o{ student_exam_questions : selected_as\n\n    student_exam_questions ||..o{ transcripts : contains&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="DZzrFBDq_QVI-X3XuUuE-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="ROLES" mermaidId="n:roles" mermaidBaseStyle="shape=table;startSize=43;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=1;fontSize=16;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;strokeWidth=1;align=center;resizeLast=1;html=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);" mermaidBaseValue="roles" id="DZzrFBDq_QVI-X3XuUuE-2">
